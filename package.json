{
  "name": "car-service-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run tenant:assets && vite",
    "build": "tsc -b && vite build && tsx scripts/tenant/render-site.ts --out dist",
    "preview": "node scripts/serve-dist.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.sw.json && deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:sql": "vitest run --project sql",
    "test:functions": "deno test --allow-net --allow-env --allow-read --config supabase/functions/deno.json supabase/functions/tests/",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:sql && npm run test:functions && npm run test:e2e",
    "db:local": "node scripts/db/local-pg.mjs start",
    "db:local:stop": "node scripts/db/local-pg.mjs stop",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:reset": "node scripts/db/migrate.mjs --reset --seed",
    "seed:generate": "tsx scripts/tenant/seed-generate.ts",
    "tenant:new": "tsx scripts/tenant/new.ts",
    "tenant:validate": "tsx scripts/tenant/validate.ts",
    "tenant:assets": "tsx scripts/tenant/assets.ts",
    "tenant:publish": "tsx scripts/tenant/publish.ts",
    "tenant:verify": "tsx scripts/tenant/verify.ts",
    "owner:invite": "tsx scripts/tenant/owner-invite.ts",
    "functions:serve": "deno run --allow-net --allow-env --allow-read --config supabase/functions/deno.json scripts/functions-dev-server.ts",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.3",
    "@astryxdesign/theme-neutral": "^0.6.3",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@stylexjs/stylex": "^0.19.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "deno": "^2.9.6",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jose": "^6.2.12",
    "jsdom": "^30.1.1",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-build": "^7.4.1"
  }
}
