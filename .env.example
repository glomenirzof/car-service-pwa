# ---------------------------------------------------------------------------
# Environment variables. This file contains NO secrets — only names, defaults
# and where each value goes. Copy the parts you need:
#
#   A. Browser build (VITE_*)  -> .env.local (local) / Cloudflare Pages env vars
#   B. Edge Function secrets   -> supabase/functions/.env (local, gitignored)
#                                 / `supabase secrets set` (hosted)
#   C. Pipeline scripts        -> your shell or CI secrets
#
# Everything with the VITE_ prefix is embedded into public JavaScript: never
# put a secret there. The service role key, the LLM key, the VAPID private key
# and the token/cron secrets exist only in B and C.
# ---------------------------------------------------------------------------

# === A. Browser build =======================================================
# Supabase project URL (one project for every studio).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (anon) key: public by design, used for owner login only.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: Edge Functions base URL. Default: $VITE_SUPABASE_URL/functions/v1.
# Local function server: http://127.0.0.1:54321/functions/v1
VITE_FUNCTIONS_URL=
# Optional: public Storage base. Default: $VITE_SUPABASE_URL/storage/v1/object/public/tenant-media
VITE_STORAGE_PUBLIC_URL=
# Web Push public key (the pair's PUBLIC half; see B for the private one).
# Empty = the UI honestly says push is not configured and offers the .ics file.
VITE_VAPID_PUBLIC_KEY=

# === B. Edge Function secrets ==============================================
# Provided automatically in hosted Edge Functions — set them only locally:
#   SUPABASE_URL, SUPABASE_DB_URL, SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_DB_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# Only if the project has legacy keys disabled: the new secret key (sb_secret_…).
SUPABASE_SECRET_KEY=

# REQUIRED. 32+ random bytes, e.g. `openssl rand -hex 32`. Booking access tokens
# are HMAC(secret, request key); only their SHA-256 hashes are stored.
BOOKING_TOKEN_SECRET=
# REQUIRED. Shared with Supabase Cron via Vault secret "cron_secret".
CRON_SECRET=

# Owner JWT verification. Default: JWKS of the project
# ($SUPABASE_URL/auth/v1/.well-known/jwks.json, asymmetric signing keys).
# Legacy HS256 projects / local stack without Auth: set the JWT secret instead.
AUTH_JWT_SECRET=
AUTH_JWKS_URL=
# Expected "iss" claim. Default: $SUPABASE_URL/auth/v1
AUTH_JWT_ISSUER=

# CORS: comma-separated origins of the site, e.g. https://book.example.com
# Default "*" (the API is token-based and sends no cookies).
ALLOWED_ORIGINS=

# Web Push (VAPID). Generate once: `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
# Dispatcher tuning.
PUSH_LEASE_SECONDS=120
PUSH_DISPATCH_BUDGET_MS=20000

# AI assistant: any OpenAI-compatible chat-completions endpoint.
# Empty LLM_BASE_URL/LLM_API_KEY/LLM_MODEL = assistant answers "unavailable",
# booking keeps working.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
# tools | json | auto (auto: native tool calls, falls back to JSON intents).
LLM_ROUTER=auto
# 1 = send response_format=json_object in the JSON router (if the provider supports it).
LLM_JSON_MODE=0
LLM_MAX_TOOL_ROUNDS=3
LLM_MAX_TOKENS=700
LLM_TIMEOUT_MS=25000
# Budgets, counted atomically in app.usage_counters (shared by all instances).
LLM_TENANT_DAILY_REQUESTS=300
LLM_TENANT_DAILY_TOKENS=300000
LLM_GLOBAL_DAILY_TOKENS=3000000

# Rate limits (shared DB counters).
# Headers the hosting proxy sets with the client IP, first match wins. List only
# headers the proxy overwrites (a client can send any header itself). Without a
# client IP, per-client limits are skipped (logged once); per-studio limits and
# LLM budgets still apply.
CLIENT_IP_HEADERS=cf-connecting-ip,x-real-ip,x-forwarded-for
RL_PUBLIC_READ_PER_MIN=120
RL_BOOKINGS_PER_10MIN=6
RL_TENANT_BOOKINGS_PER_HOUR=120
RL_TOKEN_OPS_PER_MIN=60
RL_OWNER_PER_MIN=300
RL_AI_PER_MIN=8
RL_AI_PER_DAY=60
RL_AI_OWNER_PER_MIN=20

# === C. Pipeline scripts (tenant:publish / tenant:verify / owner:invite) ====
# Direct Postgres connection (Supabase: Project Settings -> Database -> URI).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# owner:invite uses the Auth Admin API (server-side only, never in the browser).
SUPABASE_SERVICE_ROLE_KEY=
# Optional: alternative folder with studio configs (default ./tenants).
TENANTS_DIR=
