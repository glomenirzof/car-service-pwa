# Настройки запуска в интернете (см. START.md, часть Б).
# Команда `npm run cloud:prepare` сама создаст рядом копию settings.env —
# заполняйте именно её. Значение пишется сразу после «=», без пробелов и кавычек.
# settings.env содержит ключи доступа: храните его у себя, никому не пересылайте
# и не выкладывайте. Сохраните копию — без него нельзя будет обновлять сайт.

# 1. Supabase → ваш проект → Project Settings → Data API → Project URL
#    Пример: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# 2. Supabase → Project Settings → API Keys → Publishable key (начинается с sb_publishable_)
SUPABASE_PUBLISHABLE_KEY=

# 3. Supabase → Project Settings → API Keys → Secret keys → значок глаза → копировать
#    (начинается с sb_secret_). Это главный ключ: никому его не показывайте.
SUPABASE_SECRET_KEY=

# 4. Supabase → кнопка Connect вверху страницы проекта → Session pooler → строка URI.
#    В ней замените [YOUR-PASSWORD] на пароль базы, заданный при создании проекта.
#    Пример: postgresql://postgres.abcdefghijklmnop:МойПароль@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# 5. Ваша почта. Её видят push-сервисы браузеров как контакт владельца сайта.
ADMIN_EMAIL=

# 6. Имя сайта в Cloudflare: маленькие латинские буквы, цифры и дефис.
#    Сайт будет доступен по адресу https://<имя>.pages.dev
SITE_NAME=

# --- Необязательно: AI-помощник --------------------------------------------
# Любой сервис с OpenAI-совместимым API. Без этих строк запись работает,
# а помощник честно пишет, что недоступен.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Только если `npm run cloud:prepare` попросит ----------------------------
# Supabase → Project Settings → JWT Keys → Legacy JWT secret
AUTH_JWT_SECRET=

# --- Ниже строки добавляются автоматически. Не меняйте и не удаляйте их. ---
